# Copy to .env and fill in. .env is gitignored; every variable here has a
# working default except GIT_REMOTE_URL (fetch.mjs refuses to run without it).

# --- Runtime state ---
# DATA_DIR=.                  # dir for scratch/.repo/.work/logs/storageState.json;
#                             # in Docker point this at a mounted volume (default: project dir)

# --- TimeEdit ---
# TIMEEDIT_BASE_URL=https://cloud.timeedit.net/my_um/web/students/

# --- Course fetch tuning (fetch-courses-page.js) ---
# COURSE_CONCURRENCY=40          # requests in flight for event/detail probes
# COURSE_PAGE_CONCURRENCY=12     # objects.html page fetches
# COURSE_PAGE_SIZE=100
# COURSE_MAX_OBJECTS=30000
# COURSE_RETRIES=3

# --- fetch.mjs browser orchestration ---
# SCRIPT_RETRIES=3               # reload-and-retry per browser script
# NAVIGATION_TIMEOUT_MS=120000   # loading the students page (SSO re-auth can exceed 30s)
# LECTURER_TIMEOUT_MS=300000     # 5 min
# COURSE_TIMEOUT_MS=3000000      # 50 min — a full course crawl is ~25 min
# SESSION_BOUNCE_MS=15000        # wait for the SSO bounce before judging login
# SESSION_REAUTH_MS=90000        # grace period for silent SSO re-auth
# LOG_KEEP_DAYS=14

# --- git push (required) + notifications ---
GIT_REMOTE_URL=https://x-access-token:YOUR_TOKEN@github.com/Muhd-Mairaj/mmscheduler.git
# GIT_TARGET_BRANCH=main         # branch the app JSON is pushed to; must exist on origin
# NOTIFY_WEBHOOK_URL=https://example.com/hook
